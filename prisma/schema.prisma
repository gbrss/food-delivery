// Esquema PostgreSQL / Prisma ORM para Food Delivery
// Incluye todas las 22 entidades relacionales y sus índices de alto rendimiento.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  RESTAURANT
  KITCHEN
  DRIVER
  ADMIN
}

enum RestaurantStatus {
  OPEN
  CLOSED
  TEMPORARILY_UNAVAILABLE
  SUSPENDED
  PENDING_APPROVAL
}

enum OrderStatus {
  CREATED
  PENDING_PAYMENT
  PAID
  RECEIVED_BY_RESTAURANT
  ACCEPTED
  PREPARING
  READY
  ASSIGNED_TO_DRIVER
  DRIVER_PICKED_UP
  ON_THE_WAY
  DELIVERED
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
  REJECTED
}

enum PaymentStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
  REFUNDED
}

enum DriverStatus {
  OFFLINE
  AVAILABLE
  TO_RESTAURANT
  AT_RESTAURANT
  PICKING_UP
  TO_CLIENT
  DELIVERED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  phone         String
  role          Role           @default(CLIENT)
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  addresses     Address[]
  orders        Order[]        @relation("ClientOrders")
  reviews       Review[]
  notifications Notification[]
  cart          Cart?
  driverProfile Driver?
  restaurants   Restaurant[]   @relation("RestaurantOwner")

  @@index([email, role])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String   // Casa, Oficina, Pareja
  street       String
  number       String
  apartment    String?
  commune      String
  city         String   @default("Santiago")
  instructions String?
  lat          Float
  lng          Float
  isDefault    Boolean  @default(false)

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([userId])
}

model RestaurantCategory {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  icon        String
  restaurants Restaurant[]
}

model Restaurant {
  id                 String             @id @default(cuid())
  ownerId            String
  categoryId         String
  name               String
  slug               String             @unique
  description        String
  logoUrl            String
  coverUrl           String
  address            String
  commune            String
  lat                Float
  lng                Float
  phone              String
  status             RestaurantStatus   @default(OPEN)
  acceptingOrders    Boolean            @default(true)
  rating             Float              @default(4.8)
  reviewCount        Int                @default(0)
  prepTimeMinutes    Int                @default(25)
  deliveryFee        Int                @default(2500)
  minOrderAmount     Int                @default(8000)
  commissionPercent  Float              @default(15.0)
  featured           Boolean            @default(false)
  promoLabel         String?
  createdAt          DateTime           @default(now())

  owner              User               @relation("RestaurantOwner", fields: [ownerId], references: [id])
  category           RestaurantCategory @relation(fields: [categoryId], references: [id])
  productCategories  ProductCategory[]
  products           Product[]
  hours              RestaurantHours[]
  deliveryZones      DeliveryZone[]
  promotions         Promotion[]
  orders             Order[]
  reviews            Review[]

  @@index([slug, status])
  @@index([categoryId])
}

model RestaurantHours {
  id           String     @id @default(cuid())
  restaurantId String
  dayOfWeek    Int        // 0 = Domingo .. 6 = Sábado
  openTime     String     // "11:30"
  closeTime    String     // "23:00"
  isClosed     Boolean    @default(false)

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model DeliveryZone {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  radiusKm     Float      @default(6.0)
  baseFee      Int        @default(2500)
  perKmFee     Int        @default(350)

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model ProductCategory {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int        @default(0)

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]
}

model Product {
  id                String          @id @default(cuid())
  restaurantId      String
  productCategoryId String
  name              String
  description       String
  price             Int
  discountPrice     Int?
  imageUrl          String
  ingredients       String[]
  available         Boolean         @default(true)
  popular           Boolean         @default(false)
  prepMinutes       Int             @default(15)

  restaurant        Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [id])
  options           ProductOption[]
  extras            ProductExtra[]
  orderItems        OrderItem[]
  cartItems         CartItem[]

  @@index([restaurantId, available])
}

model ProductOption {
  id        String  @id @default(cuid())
  productId String
  name      String  // Ej: "Punto de cocción", "Bebida incluida"
  required  Boolean @default(true)
  choices   Json    // [{ label: "A punto", priceDelta: 0 }]

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductExtra {
  id        String  @id @default(cuid())
  productId String
  name      String  // Ej: "Doble Queso Cheddar", "Palta Hass"
  price     Int
  available Boolean @default(true)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id           String     @id @default(cuid())
  userId       String     @unique
  restaurantId String?
  couponCode   String?
  updatedAt    DateTime   @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        CartItem[]
}

model CartItem {
  id              String  @id @default(cuid())
  cartId          String
  productId       String
  quantity        Int     @default(1)
  selectedOptions Json
  selectedExtras  Json
  notes           String?

  cart            Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])
}

model Order {
  id                  String               @id @default(cuid())
  orderNumber         Int                  @unique
  clientId            String
  restaurantId        String
  addressId           String
  driverId            String?
  status              OrderStatus          @default(CREATED)
  deliveryMethod      String               @default("DELIVERY") // DELIVERY | PICKUP
  subtotal            Int
  deliveryFee         Int
  serviceFee          Int
  discountAmount      Int                  @default(0)
  total               Int
  platformCommission  Int
  restaurantEarnings  Int
  driverEarnings      Int
  couponCode          String?
  notes               String?
  estimatedMinutes    Int                  @default(30)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  client              User                 @relation("ClientOrders", fields: [clientId], references: [id])
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id])
  address             Address              @relation(fields: [addressId], references: [id])
  driver              Driver?              @relation(fields: [driverId], references: [id])
  items               OrderItem[]
  payment             Payment?
  delivery            Delivery?
  statusHistory       OrderStatusHistory[]
  review              Review?

  @@index([clientId, status])
  @@index([restaurantId, status])
  @@index([driverId, status])
  @@index([orderNumber])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  productName     String
  unitPrice       Int
  quantity        Int
  selectedOptions Json
  selectedExtras  Json
  notes           String?
  lineTotal       Int

  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  actorRole Role
  note      String?
  timestamp DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id           String               @id @default(cuid())
  orderId      String               @unique
  method       String               @default("WEBPAY_PLUS") // WEBPAY_PLUS | WEBPAY_ONECLICK
  amount       Int
  status       PaymentStatus        @default(PENDING_PAYMENT)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]
}

model PaymentTransaction {
  id                String        @id @default(cuid())
  paymentId         String
  tokenWs           String        @unique
  buyOrder          String
  sessionId         String
  amount            Int
  authorizationCode String?
  paymentTypeCode   String?       // VD (Redcompra) | VN (Crédito)
  responseCode      Int?          // 0 = Aprobado
  cardNumberLast4   String?
  installments      Int           @default(0)
  status            PaymentStatus
  rawResponse       Json?
  createdAt         DateTime      @default(now())

  payment           Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([tokenWs])
}

model Driver {
  id             String           @id @default(cuid())
  userId         String           @unique
  vehicleType    String           @default("MOTO") // MOTO | BICICLETA | AUTO
  vehiclePlate   String
  status         DriverStatus     @default(AVAILABLE)
  currentLat     Float
  currentLng     Float
  rating         Float            @default(4.9)
  completedTrips Int              @default(148)
  totalEarnings  Int              @default(425000)
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         Order[]
  deliveries     Delivery[]
  locations      DriverLocation[]

  @@index([status])
}

model DriverLocation {
  id        String   @id @default(cuid())
  driverId  String
  orderId   String?
  lat       Float
  lng       Float
  heading   Float?
  speedKmh  Float?
  timestamp DateTime @default(now())

  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, timestamp])
  @@index([orderId])
}

model Delivery {
  id              String    @id @default(cuid())
  orderId         String    @unique
  driverId        String
  pickupLat       Float
  pickupLng       Float
  dropoffLat      Float
  dropoffLng      Float
  distanceKm      Float
  etaMinutes      Int
  pickedUpAt      DateTime?
  deliveredAt     DateTime?

  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver          Driver    @relation(fields: [driverId], references: [id])
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String
  discountType    String   // PERCENT | FIXED
  discountValue   Int
  minOrderAmount  Int      @default(10000)
  maxDiscount     Int?
  active          Boolean  @default(true)
  expiresAt       DateTime
}

model Promotion {
  id              String     @id @default(cuid())
  restaurantId    String
  title           String
  description     String
  badgeText       String
  discountPercent Int
  active          Boolean    @default(true)

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Review {
  id               String     @id @default(cuid())
  orderId          String     @unique
  clientId         String
  restaurantId     String
  restaurantRating Int        // 1..5
  driverRating     Int        // 1..5
  comment          String?
  createdAt        DateTime   @default(now())

  order            Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  client           User       @relation(fields: [clientId], references: [id])
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  role      Role
  orderId   String?
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model PlatformSettings {
  id                        String   @id @default("default")
  defaultCommissionPercent  Float    @default(15.0)
  serviceFeeClp             Int      @default(500)
  baseDeliveryFeeClp        Int      @default(2500)
  driverSharePercent        Float    @default(85.0)
  webpayEnvironment         String   @default("INTEGRATION")
  webpayCommerceCode        String   @default("597055555532")
  maxLocationHistoryPerOrder Int     @default(25)
  updatedAt                 DateTime @updatedAt
}
